# WintOS settings: copied to ~/.config/wintos/env by wintos/setup.sh, read by wintos/dev.sh at
# start. A setting left empty or commented out turns its feature off; nothing here is required.
# Restart WintOS after a change.

# Where each project's notes (project.md, mine.md) live, one folder per project.
WINTOS_ROOT="$HOME/.local/share/wintos/projects"
# What a new project's first terminal runs: "claude" in your work folder, or "none" for a shell.
WINTOS_NEW_PROJECT_CMD="cd ~/code && claude"

# --- Pull requests (needs `gh auth login`) ---
# The GitHub organisations whose PRs count, comma separated; empty means all you can see.
WINTOS_GH_ORGS=""
# Your own team as org/team-slug: the daily's asks name only its members.
WINTOS_TEAM=""
# Short names for repos on the PR chips; `n` in the PR list sets them too.
# WINTOS_REPO_NAMES="$HOME/.config/wintos/repos.json"

# --- Calendar: the meeting card and the two-minute warning ---
# Your calendar's secret iCal address (Google Calendar: Settings → your calendar → "Secret address
# in iCal format"). It is a secret: keep it out of any repo.
WINTOS_CALENDAR_ICS=""
# Meeting rooms, comma separated, as address or address=Name, to tell a booked room from a guest.
WINTOS_ROOMS=""
# Never counted as free time on the Today page.
WINTOS_LUNCH="11:30-13:00"
WINTOS_WORKDAY="08:00-17:00"

# --- Daily journal: the Today page's plan and yesterday's list ---
# A folder of YYYY/MM/YYYY-MM-DD.md files; WintOS writes today's focus into them.
WINTOS_JOURNAL_DIR=""
# The template a new day's file starts from (default: ../templates/daily_template.md).
# WINTOS_JOURNAL_TEMPLATE=""
# A command of your journal's own that makes today's file, if it has one.
# WINTOS_JOURNAL_NEW=""

# --- Daily recap for the standup ---
# Reads a prompt on stdin and prints the summary; a small model is plenty.
WINTOS_RECAP_CMD="claude -p --no-session-persistence --settings '{\"disableAllHooks\":true}' --model haiku"
# An extra instruction for it, e.g. another source to search ({day} becomes the day).
# WINTOS_RECAP_EXTRA=""

# --- The fixer (merge conflicts, red CI) ---
# Where its headless Claude runs when no session of the PR is around.
WINTOS_FIX_CWD="~/code"
# WINTOS_FIX_CMD="claude -p --permission-mode auto --output-format stream-json --verbose"
